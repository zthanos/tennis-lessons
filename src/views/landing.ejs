<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <nav class="bg-blue-500 text-white p-4 mb-6">
    <div class="container mx-auto flex justify-between items-center">
      <a href="/" class="text-xl font-bold">Tennis Academy</a>
      <div>
        <a href="/signup" class="px-4">Sign Up</a>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold text-center mb-6">Login</h1>

    <% if (typeof error !== 'undefined') { %>
      <div class="bg-red-500 text-white p-2 rounded mb-4">
        <%= error %>
      </div>
    <% } %>

    <div class="bg-white p-6 rounded shadow">
      <form action="/login" method="POST">
        <div class="mb-4">
          <label for="email" class="block text-sm font-medium">Email</label>
          <input type="email" id="email" name="email" class="w-full border rounded p-2" required>
        </div>
        <div class="mb-4">
          <label for="password" class="block text-sm font-medium">Password</label>
          <input type="password" id="password" name="password" class="w-full border rounded p-2" required>
        </div>
        <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded">Login</button>
      </form>
    </div>
  </div>

  <script>
    function toggleContextMenu() {
      const menu = document.getElementById('contextMenu');
      menu.classList.toggle('hidden');
    }
  </script>
</body>
</html>