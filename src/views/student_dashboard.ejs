<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <nav class="bg-blue-500 text-white p-4 mb-6">
    <div class="container mx-auto flex justify-between items-center">
      <a href="/" class="text-xl font-bold">Tennis Academy</a>
      <div class="relative">
        <img src="/images/tennis-racket.png" alt="Profile" class="w-8 h-8 cursor-pointer" onclick="toggleContextMenu()">
        <div id="contextMenu" class="hidden absolute right-0 mt-2 w-48 bg-white border rounded shadow-lg">
          <a href="/profile" class="block px-4 py-2 text-gray-800 hover:bg-gray-200">View Profile</a>
          <a href="/logout" class="block px-4 py-2 text-gray-800 hover:bg-gray-200">Sign Out</a>
        </div>
      </div>
    </div>
  </nav>

  <div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold text-center mb-6">Player Dashboard</h1>

    <div class="bg-white p-6 rounded shadow mb-6">
      <h2 class="text-xl font-bold mb-4">Subscription Status</h2>
      <% if (subscription) { %>
        <p>Remaining Sessions: <%= subscription.remaining_sessions %></p>
        <p>Start Date: <%= subscription.start_date %></p>
        <p>End Date: <%= subscription.end_date || 'Ongoing' %></p>
      <% } else { %>
        <p>No active subscription found.</p>
      <% } %>
    </div>

    <div class="bg-white p-6 rounded shadow">
      <h2 class="text-xl font-bold mb-4">Lesson History</h2>
      <% if (lessons.length > 0) { %>
        <ul>
          <% lessons.forEach(lesson => { %>
            <li><%= lesson.date %></li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No lessons attended yet.</p>
      <% } %>
    </div>
  </div>

  <script>
    function toggleContextMenu() {
      const menu = document.getElementById('contextMenu');
      menu.classList.toggle('hidden');
    }
  </script>
</body>
</html>